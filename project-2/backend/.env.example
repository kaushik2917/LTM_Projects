# Call Sense v2: localhost simulation by default. No paid API required.
APP_MODE=mock
MOCK_MODE=true
DATABASE_URL=sqlite:///./data/callsense.db

TELEPHONY_PROVIDER=mock
# APP_MODE=real_phone activates Media Streams. Keep mock for local-only use.
# gather preserves the original Twilio speech webhook integration.
TELEPHONY_TRANSPORT=gather
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
PUBLIC_WS_URL=
HUMAN_AGENT_NUMBER=
# Required before enabling Twilio/public telephony. Never put this in frontend source.
OPERATIONS_TOKEN=
# ADMIN_API_TOKEN and AGENT_PHONE_NUMBER remain supported legacy aliases.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=local-lsa-128
RAG_TOP_K=5

# Browser modes always retain Web Speech. For Media Streams set both to azure.
STT_PROVIDER=browser
STT_MODEL=web-speech
TTS_PROVIDER=browser
TTS_VOICE=alice
VOICE_LANGUAGE=en-IN
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural
# Azure STT uses the regional short-utterance recognizer; STT_MODEL is unused there.
ENABLE_STT=true
TTS_ENABLED=true
ENABLE_TTS=true
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_GUARD=true
ENABLE_CALL_RECORDING=false
# Audio recording is not implemented; audio buffers exist only in memory.
CALL_GREETING_TEXT="Welcome to Call Sense Bank. I'm the Call Sense AI banking assistant. How may I help you today?"
VOICE_MAX_UTTERANCE_SECONDS=60
VOICE_ACTIVITY_THRESHOLD=500
STT_FAILURE_TEXT="I'm sorry, I couldn't hear that clearly. Could you repeat it?"
AI_FAILURE_TEXT="I'm having trouble processing that request. Please try once more."

SILENCE_FIRST_SECONDS=30
SILENCE_SECOND_SECONDS=90
SILENCE_END_SECONDS=180
SILENCE_FINAL_ACTION=continue
# Optional equivalent names: CALL_INITIAL_SILENCE_SECONDS,
# CALL_REPROMPT_SECONDS, CALL_END_SILENCE_SECONDS. Silence only reprompts; never ends a call.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_CALL_DURATION_MINUTES=0

VOICE_END_SILENCE_MS=1200

VOICE_PRE_ROLL_MS=300

VOICE_POST_ROLL_MS=300

VOICE_START_THRESHOLD_MS=150

STT_LOW_CONFIDENCE_THRESHOLD=0.65

CUSTOMER_SHOW_DEMO_LANGUAGE=false

WHISPER_MODEL=base.en

WHISPER_DEVICE=auto

WHISPER_COMPUTE_TYPE=int8

STT_FALLBACK_PROVIDER=browser

# VOICE_SILENCE_THRESHOLD_MS remains an alias for VOICE_END_SILENCE_MS.

# Browser Voice Demo uses Web Speech independently of telephone STT.
BROWSER_STT_MODE=browser
BROWSER_PHRASE_BIAS=false
